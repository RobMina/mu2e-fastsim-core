# Site configuration for mu2e-fastsim-core: copy to a private site.env OUTSIDE the repository, fill in, `source` it.
# Placeholders only. The umbrella repository's site.env.example holds the complete list for all stages; this file
# documents what core (mu2efastsim and its endpoint/job scripts) reads. Unset variables make the code stop with
# mu2efastsim.site.SiteConfigError (Python) or ${VAR:?...} (shell), naming the variable.

# --- FNAL side ------------------------------------------------------------------------------------------------
export M2FS_DATA=/path/to/fnal/data               # writable data/output area on FNAL storage
# export M2FS_INPUTS=/path/to/fnal/inputs         # read-only input area (default: M2FS_DATA)
export M2FS_CODE=/path/to/fnal/mu2e-fastsim       # umbrella checkout visible to FNAL-side jobs (EAF, GPVM)
# export FASTSIMKIT_FNAL_DATA=/path/to/fnal/crv_fastsim   # CRV inputs (default: <M2FS_INPUTS>/crv_fastsim; CRVFS_DATA also works)
export FASTSIMKIT_FNAL_HOST=fnal-host.example     # FNAL interactive host that serves the Mu2e-internal inputs over ssh

# --- Fermilab EAF endpoint --------------------------------------------------------------------------------------
export FASTSIMKIT_EAF_SHARED_PREFIX=/path/to/fnal/   # storage mounted by both EAF and the FNAL host
# export FASTSIMKIT_EAF_WORKDIR=/path/to/fnal/data/crv_fastsim/eafkit    # default: <M2FS_DATA>/crv_fastsim/eafkit
# export FASTSIMKIT_EAF_CODE=/path/to/fnal/mu2e-fastsim                  # default: M2FS_CODE
# export FASTSIMKIT_EAF_VENV=/path/to/fnal/data/crv_fastsim/venv_eaf     # default: <M2FS_DATA>/crv_fastsim/venv_eaf
# export EAF_TOKEN_FILE=$HOME/.eaf/token          # hub API token (mode 600)
export FASTSIMKIT_GEOMETRY_PREFIX=/path/to/fnal/  # absolute beam geometry paths must lie under it (else refused)

# --- Slurm-over-ssh endpoint (e.g. a university cluster) --------------------------------------------------------
export FASTSIMKIT_SLURM_HOST=slurm-host.example   # ssh host (key-based)
export FASTSIMKIT_SLURM_ACCOUNT=your_allocation   # Slurm account (sbatch -A)
export FASTSIMKIT_SCRATCH=/path/to/cluster/scratch/mu2efastsim   # work area on the cluster: image, kit jobs, kpp/
# export FASTSIMKIT_WORKDIR=/path/to/cluster/scratch/mu2efastsim/kit   # default: <FASTSIMKIT_SCRATCH>/kit
# export FASTSIMKIT_SIF=/path/to/cluster/scratch/mu2efastsim/mu2efastsim.sif   # default: <FASTSIMKIT_SCRATCH>/mu2efastsim.sif
# export FASTSIMKIT_CODE=/path/to/cluster/scratch/mu2efastsim/chain_code_kit   # default: <FASTSIMKIT_SCRATCH>/chain_code_kit

# --- ALCF (iri/, aurora/) and ESnet (iri/) ----------------------------------------------------------------------
# export ALCF_PROJECT=your_alcf_project           # PBS account (qsub -A, IRI job "account")
# export M2FS_EAGLE=/path/to/eagle/mu2efastsim    # Polaris work area
# export M2FS_FLARE=/path/to/flare/mu2efastsim    # Aurora work area
# export AURORA_HOST=aurora                       # ssh host (alias) of Aurora, for aurora/kpp_stream.sh
# export IRI=/path/to/genesis-skills/amsc-skills/iri-api   IRI_PY=/path/to/python-with-globus-sdk
# export ESNET_HOME=/path/to/efs/home  ESNET_PROJECT=your_esnet_project  ESNET_IMAGE_TAG=<umbrella sha7>-cpu
