{
  "name": "mu2efastsim-chain",
  "container": {
    "image": "ghcr.io/robmina/mu2e-fastsim:${ESNET_IMAGE_TAG}"
  },
  "directory": "${ESNET_WORK}/chain",
  "stdout_path": "${ESNET_WORK}/chain/chain.out",
  "stderr_path": "${ESNET_WORK}/chain/chain.err",
  "resources": {
    "node_count": 1,
    "process_count": 1,
    "cpu_cores_per_process": 8,
    "memory": 17179869184
  },
  "attributes": {
    "duration": 1800,
    "queue_name": "default",
    "account": "hackathon2610-project",
    "custom_attributes": {}
  }
}
