{
  "name": "mu2efastsim-crvbench",
  "executable": "/bin/bash",
  "arguments": [
    "${M2FS_EAGLE}/logs/crv_reco_bench.sh"
  ],
  "directory": "${M2FS_EAGLE}/logs",
  "stdout_path": "${M2FS_EAGLE}/logs/crv_reco_bench.out",
  "stderr_path": "${M2FS_EAGLE}/logs/crv_reco_bench.err",
  "resources": {
    "node_count": 1
  },
  "attributes": {
    "duration": 1800,
    "queue_name": "capacity",
    "account": "${ALCF_PROJECT}",
    "custom_attributes": {
      "filesystems": "home:eagle"
    }
  }
}