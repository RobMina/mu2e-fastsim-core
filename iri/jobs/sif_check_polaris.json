{
  "name": "mu2efastsim-sifcheck",
  "executable": "/bin/bash",
  "arguments": ["${M2FS_EAGLE}/logs/sif_check.sh"],
  "directory": "${M2FS_EAGLE}/logs",
  "stdout_path": "${M2FS_EAGLE}/logs/sif_check.out",
  "stderr_path": "${M2FS_EAGLE}/logs/sif_check.err",
  "resources": {"node_count": 1},
  "attributes": {"duration": 3600, "queue_name": "debug", "account": "${ALCF_PROJECT}",
                 "custom_attributes": {"filesystems": "home:eagle"}}
}
