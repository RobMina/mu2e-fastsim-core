{
  "name": "mu2efastsim-r3",
  "executable": "/bin/bash",
  "arguments": [
    "${M2FS_EAGLE}/logs/r3_polaris.sh"
  ],
  "directory": "${M2FS_EAGLE}/logs",
  "stdout_path": "${M2FS_EAGLE}/logs/r3_polaris.out",
  "stderr_path": "${M2FS_EAGLE}/logs/r3_polaris.err",
  "resources": {
    "node_count": 1
  },
  "attributes": {
    "duration": 3600,
    "queue_name": "debug",
    "account": "${ALCF_PROJECT}",
    "custom_attributes": {
      "filesystems": "home:eagle"
    }
  }
}
